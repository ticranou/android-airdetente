{
  "version": 8,
  "name": "AirChecklists VFR (OACI-like)",
  "metadata": {
    "note": "Style MapLibre inspire de la carte OACI 1/500000, base sur des donnees libres (OpenStreetMap via Planetiler, schema OpenMapTiles). Ne reproduit pas la carte officielle. Les couches aeronautiques (OpenAIP) sont ajoutees en GeoJSON par l'application, pas ici."
  },
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "mbtiles://basemap"
    }
  },
  "glyphs": "{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f6f4ee" } },

    { "id": "landcover-wood", "type": "fill", "source": "basemap", "source-layer": "landcover",
      "filter": ["==", "class", "wood"], "paint": { "fill-color": "#cfe4c2", "fill-opacity": 0.7 } },
    { "id": "landcover-grass", "type": "fill", "source": "basemap", "source-layer": "landcover",
      "filter": ["in", "class", "grass", "farmland"], "paint": { "fill-color": "#eaf1df", "fill-opacity": 0.6 } },

    { "id": "water", "type": "fill", "source": "basemap", "source-layer": "water",
      "paint": { "fill-color": "#a6cfe3" } },
    { "id": "waterway", "type": "line", "source": "basemap", "source-layer": "waterway",
      "paint": { "line-color": "#6fb0d2", "line-width": 1.1 } },

    { "id": "landuse-urban", "type": "fill", "source": "basemap", "source-layer": "landuse",
      "filter": ["in", "class", "residential", "suburb", "quarter", "neighbourhood"],
      "paint": { "fill-color": "#e6e2da", "fill-opacity": 0.7 } },

    { "id": "rail", "type": "line", "source": "basemap", "source-layer": "transportation",
      "filter": ["==", "class", "rail"],
      "paint": { "line-color": "#4a4a4a", "line-width": 0.9, "line-dasharray": [3, 2] } },

    { "id": "road-minor", "type": "line", "source": "basemap", "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"], "minzoom": 11,
      "paint": { "line-color": "#f2d98a", "line-width": 1.0 } },
    { "id": "road-secondary", "type": "line", "source": "basemap", "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": { "line-color": "#f4c542", "line-width": 1.6 } },
    { "id": "road-primary", "type": "line", "source": "basemap", "source-layer": "transportation",
      "filter": ["in", "class", "primary", "trunk"],
      "paint": { "line-color": "#e8823a", "line-width": 2.2 } },
    { "id": "road-motorway", "type": "line", "source": "basemap", "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": { "line-color": "#d9463b", "line-width": 3.0 } },

    { "id": "boundary", "type": "line", "source": "basemap", "source-layer": "boundary",
      "filter": ["<=", "admin_level", 2],
      "paint": { "line-color": "#8a6db0", "line-width": 1.2, "line-dasharray": [4, 2] } },

    { "id": "place-city", "type": "symbol", "source": "basemap", "source-layer": "place",
      "filter": ["in", "class", "city", "town"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 7, 11, 11, 16],
        "text-transform": "uppercase"
      },
      "paint": { "text-color": "#3a2f2f", "text-halo-color": "#ffffff", "text-halo-width": 1.4 } },
    { "id": "place-village", "type": "symbol", "source": "basemap", "source-layer": "place",
      "filter": ["in", "class", "village", "hamlet"], "minzoom": 10,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11
      },
      "paint": { "text-color": "#5a5148", "text-halo-color": "#ffffff", "text-halo-width": 1.2 } }
  ]
}
