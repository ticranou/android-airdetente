# ============================================================================
#  Configuration de la chaine de build carte VFR — AirChecklists
#  Copiez ce fichier en "config.env" et adaptez les valeurs.
#  Format : CLE=VALEUR (pas d'espaces autour du =, pas de guillemets)
# ============================================================================

# --- Zone OSM telechargee par Planetiler ---
# Nom court recherche dans l'index Geofabrik par --area (PAS un chemin).
# Utilisez un mot-cle unique : "france", "monaco", "belgium"...
# (NE PAS mettre "europe/france" : --area attend un nom, pas un chemin.)
# Le BBOX ci-dessous limite ensuite la sortie a votre zone de vol.
OSM_AREA=france

# --- Emprise (bbox) : ouest,sud,est,nord en degres (WGS84) ---
# Limite la carte a cette fenetre (fichier plus leger).
# Exemple ci-dessous : Grand Ouest (Normandie / Bretagne / Pays de Loire).
BBOX=-2.6,47.6,1.2,49.9

# --- Memoire max allouee a Planetiler (JVM). Ajustez selon votre PC. ---
JAVA_XMX=4g

# --- URL du JAR Planetiler (release officielle). ---
# Verifiez la derniere version sur https://github.com/onthegomap/planetiler/releases
PLANETILER_URL=https://github.com/onthegomap/planetiler/releases/latest/download/planetiler.jar

# --- OpenAIP : cle d'API (compte gratuit sur https://www.openaip.net) ---
# Respectez les conditions d'utilisation d'OpenAIP.
# Laissez vide pour ignorer la recuperation OpenAIP (fond de carte seul).
OPENAIP_KEY=

# --- Code pays OpenAIP (ISO 3166-1 alpha-2, minuscules) pour filtrer. ---
OPENAIP_COUNTRY=fr
